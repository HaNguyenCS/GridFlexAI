# DGX Spark — run NIM on port 8001, GridFlex on 8000
AGENT_MODE=llm
REPORTER_MODE=llm
NIM_BASE_URL=http://localhost:8001/v1
NIM_API_KEY=not-needed
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_TIMEOUT_SEC=45
LLM_STREAM_INTERVAL_SEC=15

